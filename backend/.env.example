# BYTE Exchange — Backend Environment Configuration
PORT=5000
NODE_ENV=development
DB_PATH=./data/exchange.db
CORS_ORIGIN=http://localhost:5173

# ==============================================================================
# PHASE 03: FREE MARKET DATA PROVIDERS (BUDGET: ₹0)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. US Stock Market — Alpaca (Free IEX Feed)
# ------------------------------------------------------------------------------
# Documentation: https://docs.alpaca.markets/
# Free plan uses the IEX market data feed (unconsolidated IEX volume & quotes).
# Obtain free keys from: https://app.alpaca.markets/
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_DATA_FEED=iex
ALPACA_BASE_URL=https://data.alpaca.markets
ALPACA_WS_URL=wss://stream.data.alpaca.markets/v2/iex

# ------------------------------------------------------------------------------
# 2. Indian Stock Market — Upstox V3 (NSE Equities)
# ------------------------------------------------------------------------------
# Documentation: https://upstox.com/developer/
# Free developer access for account holders.
# NOTE ON REGULATORY COMPLIANCE:
# Broker-provided market data is strictly for personal, private trading use.
# Public redistribution of raw NSE tick data is prohibited without an NSE commercial
# vendor license. Personal Upstox data is restricted to authorized private sessions.
# Public clients will receive PREVIEW or UNAVAILABLE unless commercial redistribution is true.
UPSTOX_ACCESS_TOKEN=
UPSTOX_BASE_URL=https://api.upstox.com
UPSTOX_COMMERCIAL_REDISTRIBUTION=false
UPSTOX_PRIVATE_SESSION_TOKEN=

# ------------------------------------------------------------------------------
# 3. Cryptocurrency — Binance (Public Spot REST & WebSockets)
# ------------------------------------------------------------------------------
# Documentation: https://github.com/binance/binance-spot-api-docs
# 100% Free, unauthenticated public market data (no API key required).
BINANCE_REST_URL=https://api.binance.com
BINANCE_WS_URL=wss://stream.binance.com:9443

# ------------------------------------------------------------------------------
# 4. Engine & Cache Settings
# ------------------------------------------------------------------------------
MARKET_DATA_RECONNECT=true
MARKET_DATA_CACHE_ENABLED=true
